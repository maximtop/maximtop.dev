---
import ThemeToggle from './ThemeToggle.astro';
import Layout from '../layouts/Layout.astro';
import {
  kodeInjector,
  kodeInjectorNav,
  type KodeInjectorPage,
} from '../data/kode-injector';

interface Props {
  title: string;
  description: string;
  current: KodeInjectorPage;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, current, structuredData } = Astro.props;
---

<Layout
  title={title}
  description={description}
  ogImage={kodeInjector.ogImageUrl}
  ogImageAlt="Kode Injector — inject local JavaScript and CSS into websites"
  structuredData={structuredData}
>
  <div class="mx-auto max-w-5xl px-6 py-8 sm:py-12">
    <header>
      <div class="flex items-center justify-between gap-5">
        <a
          href={kodeInjector.baseUrl}
          class="flex items-center gap-3 font-medium transition-colors hover:text-accent"
        >
          <img
            src={kodeInjector.iconUrl}
            width="40"
            height="40"
            alt=""
            class="h-9 w-9 rounded-lg"
          />
          <span>{kodeInjector.name}</span>
        </a>
        <div class="flex items-center gap-4">
          <a
            href="/"
            class="hidden text-xs tracking-[0.18em] text-muted transition-colors hover:text-accent sm:block"
          >
            MAXIMTOP.DEV
          </a>
          <ThemeToggle />
        </div>
      </div>

      <nav
        aria-label="Kode Injector"
        class="mt-7 flex flex-wrap gap-x-3 gap-y-3 border-b border-line pb-4 text-sm sm:gap-x-5"
      >
        {
          kodeInjectorNav.map((item) => (
            <a
              href={item.href}
              aria-current={item.key === current ? 'page' : undefined}
              class:list={[
                'transition-colors hover:text-accent',
                item.key === current
                  ? 'font-medium text-accent'
                  : 'text-secondary',
              ]}
            >
              {item.name}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-20 border-t border-line pt-8 pb-4 sm:mt-24">
      <nav aria-label="Product links" class="flex flex-wrap gap-x-5 gap-y-3 text-sm">
        <a href="/" class="text-secondary hover:text-accent">maximtop.dev</a>
        <a
          href={kodeInjector.githubUrl}
          target="_blank"
          rel="noopener"
          class="text-secondary hover:text-accent"
        >
          GitHub
        </a>
        <a
          href={`${kodeInjector.baseUrl}privacy/`}
          class="text-secondary hover:text-accent"
        >
          Privacy
        </a>
        <a
          href={`${kodeInjector.baseUrl}support/`}
          class="text-secondary hover:text-accent"
        >
          Support
        </a>
      </nav>
      <p class="mt-7 max-w-3xl text-xs leading-relaxed text-muted">
        Kode Injector is an independent, open-source developer tool. Only inject
        code you trust into websites you trust.
      </p>
      <p class="mt-5 text-xs text-muted">© {new Date().getFullYear()} Maxim Topciu</p>
    </footer>
  </div>
</Layout>
