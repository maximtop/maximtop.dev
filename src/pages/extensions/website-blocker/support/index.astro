---
import WebsiteBlockerShell from '../../../../components/WebsiteBlockerShell.astro';
import { websiteBlocker } from '../../../../data/website-blocker';

const description =
  'Get Website Blocker: MT setup help and troubleshooting for hostname matching, reloading a blocked page, browser compatibility, private windows, and bug reports.';

const checks = [
  'Open the extension popup, choose Open settings, and confirm the hostname appears in the saved list.',
  'Use a hostname such as example.com. A leading www. is ignored, but a different subdomain must be added separately.',
  'Make sure the site is enabled if the installed version shows an on/off control.',
  'Reload the tab or start a new navigation after adding or changing an entry.',
  'Check the browser’s extension details page for errors and confirm that Website Blocker: MT is enabled.',
  'In Firefox private windows, allow the extension in private windows before expecting it to run there.',
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${websiteBlocker.pageUrl}support/#breadcrumbs`,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'maximtop.dev',
      item: 'https://maximtop.dev/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: websiteBlocker.name,
      item: websiteBlocker.pageUrl,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Support',
      item: `${websiteBlocker.pageUrl}support/`,
    },
  ],
};
---

<WebsiteBlockerShell
  title="Website Blocker: MT Support"
  description={description}
  current="support"
  structuredData={breadcrumbSchema}
>
  <article class="pt-16 sm:pt-24">
    <header class="max-w-4xl">
      <p class="mb-5 text-xs font-medium tracking-[0.18em] text-accent uppercase">Setup and troubleshooting</p>
      <h1 class="font-display text-5xl leading-[1.06] font-medium text-balance [font-variation-settings:'WONK'_1,'SOFT'_40] sm:text-6xl">Website Blocker: MT Support</h1>
      <p class="mt-7 max-w-3xl text-lg leading-relaxed text-secondary sm:text-xl">Start with the saved hostname and a new navigation. Website Blocker: MT redirects matching top-level navigations; it does not replace an already-loaded page immediately.</p>
    </header>

    <section class="py-16 sm:py-20" aria-labelledby="checks-title">
      <p class="mb-3 text-xs font-medium tracking-[0.18em] text-accent uppercase">Quick diagnosis</p>
      <h2 id="checks-title" class="font-display text-3xl font-medium sm:text-4xl">Check these six things first</h2>
      <ol class="mt-8 grid gap-4 sm:grid-cols-2">
        {checks.map((check, index) => (
          <li class="flex gap-4 rounded-xl border border-line bg-card p-5">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent">{index + 1}</span>
            <p class="pt-1 text-sm leading-relaxed text-secondary">{check}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="border-y border-line py-16 sm:py-20" aria-labelledby="behavior-title">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div>
          <p class="mb-3 text-xs font-medium tracking-[0.18em] text-accent uppercase">Expected behavior</p>
          <h2 id="behavior-title" class="font-display text-3xl font-medium sm:text-4xl">What blocking can and cannot change</h2>
        </div>
        <dl class="divide-y divide-line overflow-hidden rounded-xl border border-line bg-card">
          <div class="grid gap-2 p-5 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <dt class="font-medium">Matching</dt>
            <dd class="text-sm leading-relaxed text-secondary">Entries match a hostname after a leading <code>www.</code> is removed. Add other subdomains separately.</dd>
          </div>
          <div class="grid gap-2 p-5 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <dt class="font-medium">Existing tabs</dt>
            <dd class="text-sm leading-relaxed text-secondary">Adding a site does not redirect a tab already showing it. Reload or navigate again to apply the rule.</dd>
          </div>
          <div class="grid gap-2 p-5 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <dt class="font-medium">Timed entries</dt>
            <dd class="text-sm leading-relaxed text-secondary">Where available, expiry stops future redirects. It does not automatically restore a tab already showing the extension’s reminder page.</dd>
          </div>
          <div class="grid gap-2 p-5 sm:grid-cols-[11rem_1fr] sm:gap-6">
            <dt class="font-medium">Scope</dt>
            <dd class="text-sm leading-relaxed text-secondary">This is a browser focus tool, not a network firewall, parental-control product, password lock, or recurring schedule service.</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="py-16 sm:py-20" aria-labelledby="compatibility-title">
      <p class="mb-3 text-xs font-medium tracking-[0.18em] text-accent uppercase">Browser compatibility</p>
      <h2 id="compatibility-title" class="font-display text-3xl font-medium sm:text-4xl">Use the controls your version includes</h2>
      <p class="mt-5 max-w-3xl leading-relaxed text-secondary">Timed blocking and editing saved entries depend on the version installed from your browser’s store. Firefox currently offers version 1.2.9; Edge offers the older 1.2.1 build. Update the extension through your browser’s store when newer controls are available. Firefox also requires separately allowing the add-on in private windows.</p>
    </section>

    <section class="rounded-2xl bg-[#0f766e] px-6 py-12 text-center text-white sm:px-12 sm:py-14" aria-labelledby="contact-title">
      <h2 id="contact-title" class="font-display text-3xl font-medium sm:text-4xl">Still need help?</h2>
      <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-[#ccfbf1]">For a useful bug report, include the browser and version, extension version, the hostname you entered, exact steps, expected result, and actual result. Remove private URLs and personal details first.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={websiteBlocker.issuesUrl} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center justify-center rounded-lg bg-white px-5 py-3 text-sm font-semibold text-[#0f5f58] transition-transform hover:-translate-y-0.5 focus-visible:outline-white">Open a GitHub issue ↗</a>
        <a href={`mailto:${websiteBlocker.contactEmail}`} class="inline-flex min-h-12 items-center justify-center rounded-lg border border-white/50 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/10">Email {websiteBlocker.contactEmail}</a>
      </div>
    </section>
  </article>
</WebsiteBlockerShell>
