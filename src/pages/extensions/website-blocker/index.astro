---
import { Image } from 'astro:assets';
import WebsiteBlockerShell from '../../../components/WebsiteBlockerShell.astro';
import { websiteBlocker } from '../../../data/website-blocker';
import blockedList from '../../../assets/extensions/website-blocker/blocked-list.png';

const description =
  'Block distracting websites with a simple, private browser extension. Website Blocker: MT keeps a user-managed hostname list in browser storage for Chrome, Firefox, and Edge.';

const features = [
  {
    title: 'A list you control',
    description:
      'Open settings from the toolbar popup and add the websites you want to avoid. Remove an entry whenever you want to allow it again.',
  },
  {
    title: 'A clear interruption',
    description:
      'When an enabled entry matches a new top-level HTTP or HTTPS navigation, the extension redirects that tab to its own reminder page.',
  },
  {
    title: 'Private by design',
    description:
      'The extension compares hostnames and stores your settings in browser extension storage. It has no account, ads, analytics, or developer-operated backend.',
  },
];

const softwareApplicationSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  '@id': `${websiteBlocker.pageUrl}#software`,
  name: websiteBlocker.name,
  description,
  url: websiteBlocker.pageUrl,
  image: `https://maximtop.dev${websiteBlocker.ogImageUrl}`,
  applicationCategory: 'ProductivityApplication',
  applicationSubCategory: 'Browser extension',
  operatingSystem: 'Chrome, Firefox, Microsoft Edge on desktop',
  browserRequirements: 'A current desktop version of a supported browser',
  isAccessibleForFree: true,
  downloadUrl: websiteBlocker.storeUrl,
  featureList: features.map((feature) => feature.title),
  offers: [
    websiteBlocker.storeUrl,
    websiteBlocker.firefoxStoreUrl,
    websiteBlocker.edgeStoreUrl,
  ].map((url) => ({
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url,
  })),
  author: {
    '@type': 'Person',
    name: 'Maxim Topciu',
    url: 'https://maximtop.dev/',
  },
  license: `${websiteBlocker.githubUrl}/blob/master/LICENSE`,
  sameAs: [
    websiteBlocker.githubUrl,
    websiteBlocker.storeUrl,
    websiteBlocker.firefoxStoreUrl,
    websiteBlocker.edgeStoreUrl,
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${websiteBlocker.pageUrl}#breadcrumbs`,
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'maximtop.dev',
      item: 'https://maximtop.dev/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: websiteBlocker.name,
      item: websiteBlocker.pageUrl,
    },
  ],
};
---

<WebsiteBlockerShell
  title="Website Blocker: MT — Block Distracting Websites"
  description={description}
  current="overview"
  structuredData={[softwareApplicationSchema, breadcrumbSchema]}
>
  <section class="pt-16 sm:pt-24" aria-labelledby="page-title">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_9rem] lg:gap-16">
      <div>
        <p class="mb-5 text-xs font-medium tracking-[0.18em] text-accent uppercase">
          Free, open-source browser extension
        </p>
        <h1
          id="page-title"
          class="font-display max-w-4xl text-5xl leading-[1.04] font-medium text-balance [font-variation-settings:'WONK'_1,'SOFT'_40] sm:text-6xl lg:text-7xl"
        >
          Put distracting websites out of the way
        </h1>
        <p class="mt-7 max-w-3xl text-lg leading-relaxed text-secondary sm:text-xl">
          Website Blocker: MT is a small focus tool for a list you choose. Add a
          hostname in settings, then a matching new navigation leads to a simple
          reminder page instead of the site.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a
            href={websiteBlocker.storeUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-12 items-center justify-center rounded-lg bg-accent px-5 py-3 text-sm font-semibold text-white transition-[background-color,transform] hover:-translate-y-0.5 hover:bg-[#075443] dark:text-[#08261f] dark:hover:bg-[#6ee7b7]"
          >
            Add to Chrome
            <span aria-hidden="true" class="ml-2">↗</span>
          </a>
          <a
            href={websiteBlocker.firefoxStoreUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-12 items-center justify-center rounded-lg border border-line bg-card px-5 py-3 text-sm font-medium text-secondary transition-colors hover:border-accent hover:text-accent"
          >
            Add to Firefox
            <span aria-hidden="true" class="ml-2">↗</span>
          </a>
          <a
            href={websiteBlocker.edgeStoreUrl}
            target="_blank"
            rel="noopener"
            class="inline-flex min-h-12 items-center justify-center rounded-lg border border-line bg-card px-5 py-3 text-sm font-medium text-secondary transition-colors hover:border-accent hover:text-accent"
          >
            Add to Edge
            <span aria-hidden="true" class="ml-2">↗</span>
          </a>
          <a
            href={`${websiteBlocker.baseUrl}support/`}
            class="inline-flex min-h-12 items-center justify-center px-2 py-3 text-sm font-medium text-secondary transition-colors hover:text-accent"
          >
            Setup and support
          </a>
        </div>
        <ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted" aria-label="Extension highlights">
          <li>✓ Free & open source</li>
          <li>✓ No account</li>
          <li>✓ No analytics</li>
        </ul>
      </div>

      <img
        src={websiteBlocker.iconUrl}
        width="128"
        height="128"
        alt=""
        class="order-first h-24 w-24 rounded-[1.35rem] shadow-lg lg:order-none lg:h-36 lg:w-36 lg:rounded-[2rem]"
      />
    </div>
    <figure class="mt-14 overflow-hidden rounded-2xl border border-line bg-card p-3 shadow-sm sm:mt-20 sm:p-5">
      <Image
        src={blockedList}
        alt="Website Blocker: MT settings showing example.com and example.org in the blocked list"
        widths={[640, 960, 1280]}
        sizes="(max-width: 1024px) calc(100vw - 3rem), 1024px"
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full rounded-lg"
      />
      <figcaption class="px-2 pt-4 pb-1 text-center text-xs leading-relaxed text-muted sm:text-sm">
        Chrome Web Store screenshot: add and remove the hostnames you want to block.
      </figcaption>
    </figure>
  </section>

  <section class="py-20 sm:py-28" aria-labelledby="how-title">
    <p class="mb-3 text-xs font-medium tracking-[0.18em] text-accent uppercase">
      A deliberate three-step workflow
    </p>
    <h2 id="how-title" class="font-display max-w-3xl text-3xl font-medium sm:text-4xl">
      Choose a site, then give yourself a pause
    </h2>
    <ol class="mt-8 grid gap-4 lg:grid-cols-3">
      <li class="rounded-xl border border-line bg-card p-6">
        <span class="text-xs font-medium tracking-[0.18em] text-accent">01</span>
        <h3 class="mt-4 text-lg font-medium">Open settings</h3>
        <p class="mt-3 text-sm leading-relaxed text-secondary">Use the toolbar popup to open Website Blocker: MT settings.</p>
      </li>
      <li class="rounded-xl border border-line bg-card p-6">
        <span class="text-xs font-medium tracking-[0.18em] text-accent">02</span>
        <h3 class="mt-4 text-lg font-medium">Add a hostname</h3>
        <p class="mt-3 text-sm leading-relaxed text-secondary">Enter a website such as <code>example.com</code>. A leading <code>www.</code> is treated as the same hostname.</p>
      </li>
      <li class="rounded-xl border border-line bg-card p-6">
        <span class="text-xs font-medium tracking-[0.18em] text-accent">03</span>
        <h3 class="mt-4 text-lg font-medium">Navigate again</h3>
        <p class="mt-3 text-sm leading-relaxed text-secondary">Reload or open the matching site. The extension replaces that top-level navigation with its blocked-page reminder.</p>
      </li>
    </ol>
  </section>

  <section class="border-y border-line py-20 sm:py-24" aria-labelledby="features-title">
    <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
      <div>
        <p class="mb-3 text-xs font-medium tracking-[0.18em] text-accent uppercase">Core behavior</p>
        <h2 id="features-title" class="font-display text-3xl font-medium sm:text-4xl">Simple enough to keep using</h2>
        <p class="mt-5 leading-relaxed text-secondary">Keep a list of the sites that interrupt your focus, then let the extension show a reminder when you navigate to an enabled match.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {features.map((feature) => (
          <article class="rounded-xl border border-line bg-card p-6">
            <h3 class="text-lg font-medium">{feature.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-secondary">{feature.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 sm:py-28" aria-labelledby="compatibility-title">
    <p class="mb-3 text-xs font-medium tracking-[0.18em] text-accent uppercase">Browser compatibility</p>
    <h2 id="compatibility-title" class="font-display max-w-3xl text-3xl font-medium sm:text-4xl">Update to get the newest controls</h2>
    <p class="mt-5 max-w-3xl leading-relaxed text-secondary">Website Blocker works in Chrome, Firefox, and Microsoft Edge. Timed blocking and editing saved entries depend on the version installed from your browser’s store. Firefox currently offers version 1.2.9; Edge offers the older 1.2.1 build. Update the extension through your browser’s store when newer controls are available.</p>
  </section>

  <section class="rounded-2xl bg-[#0f766e] px-6 py-12 text-center text-white sm:px-12 sm:py-14" aria-labelledby="limits-title">
    <h2 id="limits-title" class="font-display text-3xl font-medium sm:text-4xl">A focus tool, not a security boundary</h2>
    <p class="mx-auto mt-4 max-w-3xl leading-relaxed text-[#ccfbf1]">Website Blocker: MT checks top-level browser navigation after it commits. It is not a network firewall, parental-control system, password-protected restriction, recurring scheduler, or a way to control other people’s browsing.</p>
    <a href={`${websiteBlocker.baseUrl}support/`} class="mt-8 inline-flex min-h-12 items-center justify-center rounded-lg bg-white px-5 py-3 text-sm font-semibold text-[#0f5f58] transition-transform hover:-translate-y-0.5 focus-visible:outline-white">Read setup, limitations, and troubleshooting</a>
  </section>
</WebsiteBlockerShell>
