---
import HideUpgradeButtonShell from '../../../../components/HideUpgradeButtonShell.astro';
import { hideUpgradeButton } from '../../../../data/hide-upgrade-button';

const description =
  'Get Hide Upgrade Button support: check settings and site access, understand safe fallback behavior, and report a reproducible problem through GitHub Issues.';

const checks = [
  'Confirm the extension is enabled in your browser’s extensions page.',
  'Open the extension popup and confirm the toggle for the visible button is on.',
  'Confirm the page is Gmail, Google Drive, Google Docs, Sheets, Slides, or one of their home screens.',
  'For Google Calendar, enable its optional access once in the extension popup.',
  'Confirm whether the problem affects Upgrade, Ask Gemini, or both.',
  'Note the extension version, browser, Google product, and exact steps before reporting the problem.',
];
---

<HideUpgradeButtonShell
  title="Hide Upgrade Button Support"
  description={description}
  current="support"
>
  <article class="pt-16 sm:pt-24">
    <header class="max-w-4xl">
      <p class="mb-5 text-xs font-medium tracking-[0.18em] text-accent uppercase">
        Help and bug reports
      </p>
      <h1 class="font-display text-5xl leading-[1.06] font-medium text-balance [font-variation-settings:'WONK'_1,'SOFT'_40] sm:text-6xl">
        Hide Upgrade Button Support
      </h1>
      <p class="mt-7 max-w-3xl text-lg leading-relaxed text-secondary sm:text-xl">
        Check the relevant toggle and site access first. If a Google interface change has made a button reappear, report the page and button through GitHub Issues.
      </p>
    </header>

    <section class="py-16 sm:py-20" aria-labelledby="checks-title">
      <p class="mb-3 text-xs font-medium tracking-[0.18em] text-accent uppercase">Quick diagnosis</p>
      <h2 id="checks-title" class="font-display text-3xl font-medium sm:text-4xl">
        Check these six things first
      </h2>
      <ol class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          checks.map((check, index) => (
            <li class="flex gap-4 rounded-xl border border-line bg-card p-5">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent">
                {index + 1}
              </span>
              <p class="pt-1 text-sm leading-relaxed text-secondary">{check}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="border-y border-line py-16 sm:py-20" aria-labelledby="behavior-title">
      <p class="mb-3 text-xs font-medium tracking-[0.18em] text-accent uppercase">Expected behavior</p>
      <h2 id="behavior-title" class="font-display text-3xl font-medium sm:text-4xl">
        What happens when Google changes a header
      </h2>
      <p class="mt-5 max-w-3xl leading-relaxed text-secondary">
        The extension identifies buttons through accessible labels, roles, header scope, and locale-independent structural signals. It does not depend on Google’s obfuscated CSS class names.
      </p>
      <p class="mt-4 max-w-3xl leading-relaxed text-secondary">
        When a match is ambiguous, the extension leaves the page unchanged rather than hide the wrong control. If Google changes its markup beyond recognition, the button may return until an extension update restores hiding.
      </p>
    </section>

    <section class="py-16 sm:py-20" aria-labelledby="report-title">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div>
          <p class="mb-3 text-xs font-medium tracking-[0.18em] text-accent uppercase">Reproducible reports</p>
          <h2 id="report-title" class="font-display text-3xl font-medium sm:text-4xl">
            Include the details that identify the change
          </h2>
          <p class="mt-5 leading-relaxed text-secondary">
            If a button stopped being hidden, attach the button’s <code>outerHTML</code> when you can. Remove private information before posting anything publicly.
          </p>
        </div>
        <dl class="divide-y divide-line overflow-hidden rounded-xl border border-line bg-card">
          <div class="grid gap-2 p-5 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <dt class="font-medium">Environment</dt>
            <dd class="text-sm leading-relaxed text-secondary">Browser and extension version, plus Gmail, Drive, Docs, Sheets, Slides, or Calendar.</dd>
          </div>
          <div class="grid gap-2 p-5 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <dt class="font-medium">Button</dt>
            <dd class="text-sm leading-relaxed text-secondary">Whether Upgrade, Ask Gemini, or both remain visible, and the current toggle state.</dd>
          </div>
          <div class="grid gap-2 p-5 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <dt class="font-medium">Reproduction</dt>
            <dd class="text-sm leading-relaxed text-secondary">Exact steps and, if possible, the affected button’s <code>outerHTML</code> with private information removed.</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="rounded-2xl bg-[#0f766e] px-6 py-12 text-center text-white sm:px-12 sm:py-14" aria-labelledby="issues-title">
      <h2 id="issues-title" class="font-display text-3xl font-medium sm:text-4xl">
        Report bugs and share ideas on GitHub
      </h2>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed text-[#ccfbf1]">
        GitHub Issues is the public support channel for buttons that reappear, compatibility problems, bugs, and feature ideas.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a
          href={hideUpgradeButton.issuesUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-12 items-center justify-center rounded-lg bg-white px-5 py-3 text-sm font-semibold text-[#0f5f58] transition-transform hover:-translate-y-0.5 focus-visible:outline-white"
        >
          Browse existing issues
          <span aria-hidden="true" class="ml-2">↗</span>
        </a>
        <a
          href={hideUpgradeButton.newIssueUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-12 items-center justify-center rounded-lg border border-white/40 px-5 py-3 text-sm font-medium text-white transition-colors hover:border-white"
        >
          Open a new issue
          <span aria-hidden="true" class="ml-2">↗</span>
        </a>
      </div>
    </section>
  </article>
</HideUpgradeButtonShell>
