---
import ExtensionsUpdateTrackerShell from '../../../../components/ExtensionsUpdateTrackerShell.astro';
import { extensionsUpdateTracker as tracker } from '../../../../data/extensions-update-tracker';
const description = 'Extensions Update Tracker privacy policy: local extension metadata and history, no network requests, no analytics, permissions, retention, and deletion.';
---
<ExtensionsUpdateTrackerShell title="Extensions Update Tracker Privacy Policy" description={description} current="privacy">
  <article class="pt-16 sm:pt-24"><header class="max-w-4xl"><p class="mb-5 text-xs font-medium tracking-[0.18em] text-accent uppercase">Privacy policy</p><h1 class="font-display text-5xl leading-[1.06] font-medium text-balance sm:text-6xl">Extensions Update Tracker Privacy Policy</h1><p class="mt-6 text-sm text-muted">Last updated: <time datetime="2026-07-25">July 25, 2026</time></p><p class="mt-7 max-w-3xl text-lg leading-relaxed text-secondary">Extensions Update Tracker does not collect, transmit, or sell data. It makes no network requests. Everything it records stays in local storage in your browser profile.</p></header>
  <aside class="mt-12 rounded-2xl border border-accent/25 bg-accent-soft p-6 sm:p-8"><h2 class="font-display text-2xl font-medium">Plain-language summary</h2><ul class="mt-5 grid gap-3 text-sm text-secondary sm:grid-cols-2"><li class="rounded-lg bg-card/70 px-4 py-3">No account, analytics, telemetry, or crash reporting</li><li class="rounded-lg bg-card/70 px-4 py-3">No host permissions or access to visited pages</li><li class="rounded-lg bg-card/70 px-4 py-3">History and settings remain in browser-local storage</li><li class="rounded-lg bg-card/70 px-4 py-3">No advertising, data sharing, or sale</li></ul></aside>
  <div class="mt-16 max-w-4xl space-y-14 sm:mt-20">
    <section><h2 class="font-display text-3xl font-medium">What is stored, and where</h2><p class="mt-5 leading-relaxed text-secondary">For each installed extension, the tracker locally records its ID, name, icon reference, current and previously seen versions, the time a version was first detected, and whether an update is marked read. It also stores your notification, sound, auto-disable, and mute settings.</p><p class="mt-5 leading-relaxed text-secondary">This data is stored in extension-local storage within your browser profile. Browser sync storage is not used.</p></section>
    <section><h2 class="font-display text-3xl font-medium">What is not collected</h2><ul class="mt-5 list-disc space-y-3 pl-6 leading-relaxed text-secondary marker:text-accent"><li>No accounts, sign-in, or user identifiers</li><li>No analytics, telemetry, or crash reports</li><li>No browsing history, page content, or form input</li><li>No advertising or sharing with third parties</li></ul><p class="mt-5 leading-relaxed text-secondary">The extension has no host permissions and no content scripts, so it cannot read the pages you visit.</p></section>
    <section><h2 class="font-display text-3xl font-medium">Permissions</h2><dl class="mt-6 divide-y divide-line overflow-hidden rounded-xl border border-line bg-card">{[['Management', 'Reads installed extensions and version numbers. On Chrome and Edge it also supports the optional auto-disable setting.'], ['Notifications', 'Shows local desktop notifications when an extension update is detected.'], ['Storage', 'Keeps update history and settings on the device.']].map(([term, copy]) => <div class="grid gap-2 p-5 sm:grid-cols-[10rem_1fr]"><dt class="font-medium">{term}</dt><dd class="text-sm leading-relaxed text-secondary">{copy}</dd></div>)}</dl></section>
    <section><h2 class="font-display text-3xl font-medium">Removing your data</h2><ul class="mt-5 list-disc space-y-3 pl-6 leading-relaxed text-secondary marker:text-accent"><li>Uninstalling a tracked extension deletes its update history automatically.</li><li>Resetting settings returns preferences to their defaults.</li><li>Uninstalling Extensions Update Tracker causes the browser to remove its local storage and complete history.</li></ul></section>
    <section><h2 class="font-display text-3xl font-medium">Changes and contact</h2><p class="mt-5 leading-relaxed text-secondary">Changes will be published on this page and in the public repository with an updated date. Questions can be sent to <a class="text-accent underline underline-offset-4" href={`mailto:${tracker.contactEmail}`}>{tracker.contactEmail}</a> or filed through <a class="text-accent underline underline-offset-4" href={tracker.issuesUrl} target="_blank" rel="noopener">GitHub Issues</a>.</p></section>
  </div><p class="mt-16 border-t border-line pt-6 text-sm text-muted">Source version: <a class="text-accent underline underline-offset-4" href={`${tracker.githubUrl}/blob/master/PRIVACY.md`} target="_blank" rel="noopener">PRIVACY.md on GitHub</a>.</p></article>
</ExtensionsUpdateTrackerShell>
