---
import ExtensionsUpdateTrackerShell from '../../../../components/ExtensionsUpdateTrackerShell.astro';
import { extensionsUpdateTracker as tracker } from '../../../../data/extensions-update-tracker';
const description = 'Get Extensions Update Tracker support: check update detection and local settings, report reproducible bugs on GitHub, or contact the developer about privacy.';
const checks = ['Confirm the installed extension version actually changed after the tracker established its first-run baseline.', 'Check that you are using the same browser profile; update history is local to each profile.', 'Check notification and per-extension mute settings if history appears but no alert was shown.', 'Remember that opening the options page clears the toolbar badge without marking history entries as read.', 'On Chrome or Edge, check whether optional auto-disable is enabled if an updated extension is unexpectedly off.', 'Record your browser, operating system, and tracker version before opening a report.'];
---
<ExtensionsUpdateTrackerShell title="Extensions Update Tracker Support & Bug Reports" description={description} current="support">
  <article class="pt-16 sm:pt-24"><header class="max-w-4xl"><p class="mb-5 text-xs font-medium tracking-[0.18em] text-accent uppercase">Help and bug reports</p><h1 class="font-display text-5xl leading-[1.06] font-medium text-balance sm:text-6xl">Extensions Update Tracker Support</h1><p class="mt-7 max-w-3xl text-lg leading-relaxed text-secondary sm:text-xl">Start by checking the browser profile, version change, and local notification settings. Then send a small, reproducible report if the problem remains.</p></header>
  <section class="py-16 sm:py-20"><h2 class="font-display text-3xl font-medium sm:text-4xl">Check these details first</h2><ol class="mt-8 grid gap-4 sm:grid-cols-2">{checks.map((check, index) => <li class="flex gap-4 rounded-xl border border-line bg-card p-5"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent">{index + 1}</span><p class="pt-1 text-sm leading-relaxed text-secondary">{check}</p></li>)}</ol><a href={`${tracker.baseUrl}faq/`} class="mt-6 inline-block text-sm font-medium text-accent underline underline-offset-4">Read detailed answers →</a></section>
  <section class="border-y border-line py-16 sm:py-20"><div class="grid gap-10 lg:grid-cols-2 lg:gap-16"><div><h2 class="font-display text-3xl font-medium sm:text-4xl">Make a useful bug report</h2><p class="mt-5 leading-relaxed text-secondary">Include exact steps, what you expected, what happened, and whether you can reproduce it after restarting the browser.</p></div><dl class="divide-y divide-line overflow-hidden rounded-xl border border-line bg-card"><div class="p-5"><dt class="font-medium">Environment</dt><dd class="mt-2 text-sm text-secondary">Browser and version, operating system, and Extensions Update Tracker version.</dd></div><div class="p-5"><dt class="font-medium">Evidence</dt><dd class="mt-2 text-sm text-secondary">Visible error text and a safe screenshot or short sequence of steps. Remove private extension names if needed.</dd></div></dl></div></section>
  <section class="py-16 sm:py-20"><h2 class="font-display text-3xl font-medium sm:text-4xl">Contact</h2><div class="mt-8 grid gap-4 sm:grid-cols-2"><a href={tracker.issuesUrl} target="_blank" rel="noopener" class="rounded-xl border border-line bg-card p-6 hover:border-accent"><p class="text-xs font-medium tracking-[0.18em] text-accent uppercase">Public bugs and features</p><h3 class="mt-3 text-lg font-medium">Open a GitHub issue ↗</h3><p class="mt-2 text-sm text-secondary">For reproducible defects, compatibility reports, and feature proposals.</p></a><a href={`mailto:${tracker.contactEmail}`} class="rounded-xl border border-line bg-card p-6 hover:border-accent"><p class="text-xs font-medium tracking-[0.18em] text-accent uppercase">Privacy and sensitive contact</p><h3 class="mt-3 text-lg font-medium">Email {tracker.contactEmail}</h3><p class="mt-2 text-sm text-secondary">For privacy questions or concerns that should not be public.</p></a></div></section></article>
</ExtensionsUpdateTrackerShell>
