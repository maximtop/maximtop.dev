---
import ExtensionsUpdateTrackerShell from '../../../../components/ExtensionsUpdateTrackerShell.astro';
import { extensionsUpdateTracker as tracker } from '../../../../data/extensions-update-tracker';
const description = 'Learn how Extensions Update Tracker detects browser extension version changes, records local history, alerts you, and helps you review updates.';
const steps = [
  ['Install the tracker', 'Add it from your browser store. It begins with a local baseline of the extensions already installed.'],
  ['Keep browsing normally', 'When the browser reports an installed extension update, the tracker compares the new version with the version it previously recorded.'],
  ['Review the alert', 'A local desktop notification shows the extension and version change. The toolbar badge counts unread updates.'],
  ['Open the history', 'Search, sort, mark updates as read, mute individual alerts, or use the available extension actions.'],
];
---
<ExtensionsUpdateTrackerShell title="How Extensions Update Tracker Detects Browser Extension Updates" description={description} current="how-it-works">
  <article class="pt-16 sm:pt-24"><header class="max-w-4xl"><p class="mb-5 text-xs font-medium tracking-[0.18em] text-accent uppercase">How it works</p><h1 class="font-display text-5xl leading-[1.06] font-medium text-balance sm:text-6xl">From silent update to reviewable history</h1><p class="mt-7 max-w-3xl text-lg leading-relaxed text-secondary sm:text-xl">The tracker listens for changes to installed extensions, compares version numbers, and keeps the result on your device.</p></header>
  <section class="py-16 sm:py-20" aria-labelledby="steps-title"><h2 id="steps-title" class="font-display text-3xl font-medium sm:text-4xl">Four steps</h2><ol class="mt-8 grid gap-4 sm:grid-cols-2">{steps.map(([title, copy], index) => <li class="rounded-xl border border-line bg-card p-6"><span class="text-xs font-medium tracking-[0.18em] text-accent">{String(index + 1).padStart(2, '0')}</span><h3 class="mt-4 text-lg font-medium">{title}</h3><p class="mt-2 text-sm leading-relaxed text-secondary">{copy}</p></li>)}</ol></section>
  <section class="border-y border-line py-16 sm:py-20" aria-labelledby="controls-title"><div class="max-w-3xl"><h2 id="controls-title" class="font-display text-3xl font-medium sm:text-4xl">Choose how much interruption you want</h2><p class="mt-5 leading-relaxed text-secondary">Turn desktop notifications and their sound on or off. Mute one extension without losing its history. On Chrome and Edge, the optional auto-disable setting can leave newly updated extensions off until you review and re-enable them.</p><p class="mt-5 text-sm leading-relaxed text-muted">Firefox does not support auto-disable for ordinary extensions, so that option is unavailable there.</p></div></section>
  <section class="py-16 sm:py-20"><h2 class="font-display text-3xl font-medium sm:text-4xl">What the permissions do</h2><dl class="mt-8 divide-y divide-line overflow-hidden rounded-xl border border-line bg-card">{[['Management', 'Reads installed extensions and version numbers; also powers the optional auto-disable setting where supported.'], ['Notifications', 'Shows local desktop alerts when an update is detected.'], ['Storage', 'Keeps update history and settings in your browser profile.']].map(([term, copy]) => <div class="grid gap-2 p-5 sm:grid-cols-[10rem_1fr] sm:gap-6"><dt class="font-medium">{term}</dt><dd class="text-sm leading-relaxed text-secondary">{copy}</dd></div>)}</dl><p class="mt-5 leading-relaxed text-secondary">There are no host permissions or content scripts, so the tracker cannot read the websites you visit.</p></section>
  <section class="rounded-2xl bg-[#0f766e] px-6 py-12 text-center text-white sm:px-12"><h2 class="font-display text-3xl font-medium sm:text-4xl">Start a local update history</h2><div class="mt-8 flex flex-wrap justify-center gap-4"><a href={tracker.chromeStoreUrl} target="_blank" rel="noopener" class="rounded-lg bg-white px-5 py-3 text-sm font-semibold text-[#0f5f58]">Add to Chrome ↗</a><a href={`${tracker.baseUrl}faq/`} class="rounded-lg border border-white/40 px-5 py-3 text-sm font-medium">Read the FAQ</a></div></section></article>
</ExtensionsUpdateTrackerShell>
