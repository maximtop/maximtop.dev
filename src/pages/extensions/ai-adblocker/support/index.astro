---
import ExtensionShell from '../../../../components/ExtensionShell.astro';
import { aiAdBlocker, aiAdBlockerNav } from '../../../../data/ai-adblocker';

const description =
  'AI AdBlocker support: configure a model provider, test custom rules, troubleshoot matching and API errors, and report reproducible issues.';
const product = {
  ...aiAdBlocker,
  ogImageAlt: 'AI AdBlocker support',
  footerNote: 'AI AdBlocker is experimental. A minimal reproducible rule is the fastest route to a useful diagnosis.',
};

const checks = [
  'Confirm AI AdBlocker and the individual rule are enabled.',
  'Check that the rule domain and optional path match the current page.',
  'Use a CSS selector that matches the intended candidate elements.',
  'Choose a compatible model for the embedding, prompt, or vision condition.',
  'Add the required OpenAI or OpenRouter key when using a cloud model.',
  'Run the built-in rule test, then reload the target page after changes.',
];
---

<ExtensionShell title="AI AdBlocker Support" description={description} current="support" product={product} nav={aiAdBlockerNav}>
  <article class="pt-16 sm:pt-24">
    <header class="max-w-4xl">
      <p class="mb-5 text-xs font-medium tracking-[0.18em] text-accent uppercase">Setup, troubleshooting, and reports</p>
      <h1 class="font-display text-5xl leading-[1.06] font-medium text-balance [font-variation-settings:'WONK'_1,'SOFT'_40] sm:text-6xl">AI AdBlocker Support</h1>
      <p class="mt-7 max-w-3xl text-lg leading-relaxed text-secondary sm:text-xl">Start with a narrow selector and one clear condition. Test it on the target page before expanding the rule.</p>
      <p class="mt-4 text-sm text-muted">Installation requires desktop Chrome 149 or later. Built-in AI availability can also vary by device and browser configuration.</p>
    </header>

    <section class="py-16 sm:py-20" aria-labelledby="start-title">
      <p class="mb-3 text-xs font-medium tracking-[0.18em] text-accent uppercase">First rule</p>
      <h2 id="start-title" class="font-display text-3xl font-medium sm:text-4xl">Configure the model, scope, and match</h2>
      <ol class="mt-8 grid gap-4 sm:grid-cols-3">
        <li class="rounded-xl border border-line bg-card p-6"><span class="text-xs font-semibold text-accent">01</span><h3 class="mt-3 text-lg font-medium">Choose a provider</h3><p class="mt-2 text-sm leading-relaxed text-secondary">Use Chrome built-in AI, a local LM Studio model, or your own OpenAI or OpenRouter account.</p></li>
        <li class="rounded-xl border border-line bg-card p-6"><span class="text-xs font-semibold text-accent">02</span><h3 class="mt-3 text-lg font-medium">Limit the candidates</h3><p class="mt-2 text-sm leading-relaxed text-secondary">Set a domain, optional path, and CSS selector before adding an AI condition.</p></li>
        <li class="rounded-xl border border-line bg-card p-6"><span class="text-xs font-semibold text-accent">03</span><h3 class="mt-3 text-lg font-medium">Test the result</h3><p class="mt-2 text-sm leading-relaxed text-secondary">Use the rule test to see what matched, then adjust the instruction or threshold.</p></li>
      </ol>
    </section>

    <section class="border-y border-line py-16 sm:py-20" aria-labelledby="checks-title">
      <p class="mb-3 text-xs font-medium tracking-[0.18em] text-accent uppercase">Quick diagnosis</p>
      <h2 id="checks-title" class="font-display text-3xl font-medium sm:text-4xl">Check these six things first</h2>
      <ol class="mt-8 grid gap-4 sm:grid-cols-2">
        {checks.map((check, index) => (
          <li class="flex gap-4 rounded-xl border border-line bg-card p-5"><span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent-soft text-xs font-semibold text-accent">{index + 1}</span><p class="pt-1 text-sm leading-relaxed text-secondary">{check}</p></li>
        ))}
      </ol>
      <p class="mt-6 text-sm leading-relaxed text-muted">If a local model fails, confirm LM Studio is running and its selected model is loaded. If a cloud model fails, check the key, provider balance or quota, and the selected model’s text or vision capability.</p>
    </section>

    <section class="py-16 sm:py-20" aria-labelledby="report-title">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div><p class="mb-3 text-xs font-medium tracking-[0.18em] text-accent uppercase">Reproducible reports</p><h2 id="report-title" class="font-display text-3xl font-medium sm:text-4xl">Share a minimal safe example</h2><p class="mt-5 leading-relaxed text-secondary">Never post API keys, private page text, personal information, or unredacted screenshots. A public test page and reduced rule are easier to diagnose.</p></div>
        <dl class="divide-y divide-line overflow-hidden rounded-xl border border-line bg-card">
          <div class="grid gap-2 p-5 sm:grid-cols-[9rem_1fr] sm:gap-6"><dt class="font-medium">Environment</dt><dd class="text-sm leading-relaxed text-secondary">Chrome version, extension version, operating system, provider, and model.</dd></div>
          <div class="grid gap-2 p-5 sm:grid-cols-[9rem_1fr] sm:gap-6"><dt class="font-medium">Rule</dt><dd class="text-sm leading-relaxed text-secondary">Domain, path, selector, condition type, and a sanitized instruction.</dd></div>
          <div class="grid gap-2 p-5 sm:grid-cols-[9rem_1fr] sm:gap-6"><dt class="font-medium">Result</dt><dd class="text-sm leading-relaxed text-secondary">Steps, expected result, actual result, and exact error text with secrets removed.</dd></div>
        </dl>
      </div>
    </section>

    <section class="rounded-2xl bg-[#0f766e] px-6 py-12 text-center text-white sm:px-12 sm:py-14" aria-labelledby="contact-title">
      <h2 id="contact-title" class="font-display text-3xl font-medium sm:text-4xl">Still need help?</h2>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed text-[#ccfbf1]">Use GitHub for public bugs and feature requests. Email the developer for privacy questions or sensitive contact.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={aiAdBlocker.issuesUrl} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center justify-center rounded-lg bg-white px-5 py-3 text-sm font-semibold text-[#0f5f58] transition-transform hover:-translate-y-0.5 focus-visible:outline-white">Open a GitHub issue ↗</a>
        <a href={`mailto:${aiAdBlocker.contactEmail}`} class="inline-flex min-h-12 items-center justify-center rounded-lg border border-[#99f6e4] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#115e59]">Email {aiAdBlocker.contactEmail}</a>
      </div>
    </section>
  </article>
</ExtensionShell>
