---
import SplitForHackerNewsShell from '../../../../components/SplitForHackerNewsShell.astro';
import { splitForHackerNews } from '../../../../data/split-for-hacker-news';

const description =
  'Answers to common questions about installing, using, and troubleshooting Split for Hacker News in Google Chrome.';

const faqs = [
  {
    question: 'What does Split for Hacker News do?',
    answer:
      'It finds Hacker News submissions that link to the public article you are reading. You can open a selected discussion in Chrome’s side panel or in a reusable adjacent tab.',
  },
  {
    question: 'Which browsers are supported?',
    answer:
      'The public release supports Google Chrome 140 or newer. Other browser packages may exist in the source repository, but they are not offered here as supported public releases.',
  },
  {
    question: 'How does it find the matching Hacker News discussion?',
    answer:
      'After you request a lookup, the extension sanitizes eligible public article URL candidates and searches Algolia’s public Hacker News index. It verifies exact URL identity locally instead of guessing from an article title.',
  },
  {
    question: 'Why does an article sometimes have no result?',
    answer:
      'The article may not have been submitted, or its Hacker News submission may point to a different canonical URL, mirror, or edition. Exact matching intentionally avoids unrelated title-based results.',
  },
  {
    question: 'Which pages are not eligible for lookup?',
    answer:
      'Only public HTTP and HTTPS article URLs are eligible. Local or private addresses, special-use hostnames, URLs with embedded credentials, and URLs whose query string appears to contain a secret are rejected before any search request.',
  },
  {
    question: 'Does the extension read article text or track browsing?',
    answer:
      'No article text is read. There is no telemetry, advertising, account, or developer backend. Eligible sanitized URL candidates go to Algolia only for a requested lookup or the optional automatic badge feature.',
  },
  {
    question: 'Why does the side panel need special access to Hacker News?',
    answer:
      'The panel embeds the real Hacker News site. While the panel is open, the extension temporarily removes Hacker News framing headers from Hacker News sub-frame responses; the rule is removed when the panel closes.',
  },
  {
    question: 'Is this an official Hacker News extension?',
    answer:
      'No. Split for Hacker News is an independent open-source project and is not affiliated with or endorsed by Y Combinator or Hacker News.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${splitForHackerNews.pageUrl}faq/#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${splitForHackerNews.pageUrl}faq/#breadcrumbs`,
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://maximtop.dev/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: splitForHackerNews.name,
        item: splitForHackerNews.pageUrl,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'FAQ',
        item: `${splitForHackerNews.pageUrl}faq/`,
      },
    ],
  },
];
---

<SplitForHackerNewsShell
  title="Split for Hacker News FAQ"
  description={description}
  current="faq"
  structuredData={structuredData}
>
  <article class="pt-16 sm:pt-24">
    <header class="max-w-4xl">
      <p class="mb-5 text-xs font-medium tracking-[0.18em] text-accent uppercase">
        Product answers
      </p>
      <h1 class="font-display text-5xl leading-[1.06] font-medium text-balance [font-variation-settings:'WONK'_1,'SOFT'_40] sm:text-6xl">
        Split for Hacker News FAQ
      </h1>
      <p class="mt-7 max-w-3xl text-lg leading-relaxed text-secondary sm:text-xl">
        Short answers about exact URL matching, supported pages, Chrome’s side
        panel, and the extension’s privacy boundary.
      </p>
    </header>

    <section class="py-16 sm:py-20" aria-label="Frequently asked questions">
      <div class="divide-y divide-line border-y border-line">
        {
          faqs.map((faq, index) => (
            <details class="group py-6" open={index === 0 ? true : undefined}>
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-medium marker:hidden">
                <span>{faq.question}</span>
                <span aria-hidden="true" class="text-accent group-open:rotate-45">+</span>
              </summary>
              <p class="mt-4 max-w-3xl leading-relaxed text-secondary">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="grid gap-4 sm:grid-cols-2" aria-label="Detailed guides">
      <a
        href={splitForHackerNews.findDiscussionUrl}
        class="rounded-xl border border-line bg-card p-6 transition-colors hover:border-accent"
      >
        <p class="text-xs font-medium tracking-[0.18em] text-accent uppercase">Matching guide</p>
        <h2 class="mt-3 text-lg font-medium">Find an article’s HN discussion</h2>
        <p class="mt-2 text-sm leading-relaxed text-secondary">Learn what exact matching means and what to try when a submission uses another URL.</p>
      </a>
      <a
        href={splitForHackerNews.readSideBySideUrl}
        class="rounded-xl border border-line bg-card p-6 transition-colors hover:border-accent"
      >
        <p class="text-xs font-medium tracking-[0.18em] text-accent uppercase">Reading guide</p>
        <h2 class="mt-3 text-lg font-medium">Read the article and comments side by side</h2>
        <p class="mt-2 text-sm leading-relaxed text-secondary">Compare the side panel and adjacent-tab workflows without losing the article.</p>
      </a>
    </section>

    <p class="mt-8 text-sm leading-relaxed text-secondary">
      Still having trouble? See the{' '}
      <a class="font-medium text-accent underline underline-offset-4" href={`${splitForHackerNews.baseUrl}support/`}>support checklist</a>.
    </p>
  </article>
</SplitForHackerNewsShell>
