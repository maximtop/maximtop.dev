---
import KodeInjectorShell from '../../../../components/KodeInjectorShell.astro';
import { kodeInjector } from '../../../../data/kode-injector';

const description =
  'Kode Injector FAQ and troubleshooting: fix local file access, hostname matching, disabled rules, Native Helper issues, permissions, privacy, and browser setup.';

const faqs = [
  {
    question: 'What does Kode Injector do?',
    answer:
      'Kode Injector maps website hostnames to local JavaScript and CSS files. When you open a matching website, it reads the files you configured and applies their current contents automatically.',
  },
  {
    question: 'Why is my JavaScript or CSS not being injected?',
    answer:
      'Check that the rule hostname matches the current page, each path points to an existing local file, the rule and required file toggles are enabled, the current site is not disabled in the popup, and global injection is not paused.',
  },
  {
    question: 'Why does the popup say “No injections”?',
    answer:
      'No enabled rule matches the current page hostname. Open Kode Injector Options and create a rule for that site, or confirm that an existing rule uses the correct hostname.',
  },
  {
    question: 'Why can’t Kode Injector read my local file in Chrome or Edge?',
    answer:
      'Open the browser’s extension details for Kode Injector, enable “Allow access to file URLs”, return to Options, and select “Check again”. Also confirm the path is an absolute local path or a valid file:/// URL.',
  },
  {
    question: 'Do I need Kode Injector Helper in Chrome or Edge?',
    answer:
      'No. Browser-managed file access is the default and simplest method. The read-only Native Helper is an optional advanced alternative in Chrome and Edge, while Firefox requires it.',
  },
  {
    question: 'Can a rule inject only JavaScript or only CSS?',
    answer:
      'Yes. A rule needs at least one source file, but the other field can be left empty. JavaScript and CSS can also be enabled or disabled independently after the rule is created.',
  },
  {
    question: 'What local files can the Helper read?',
    answer:
      'The Helper reads only explicitly requested local regular files up to 5 MiB. It cannot write files, list directories, execute programs, start subprocesses, or access the network.',
  },
  {
    question: 'Does Kode Injector collect browsing data or analytics?',
    answer:
      'No. It has no developer-operated backend or analytics service. Rules, preferences, hostnames, file paths, and file contents remain on the user’s device unless the configured code itself sends data from the target page.',
  },
  {
    question: 'Can a website see the code I inject?',
    answer:
      'Yes. Selected CSS is inserted into the page and JavaScript runs in the page’s main world. The configured website can inspect or process that code, so use only trusted local code on websites you trust.',
  },
  {
    question: 'How do I update or remove Kode Injector Helper?',
    answer:
      'Helper updates are manual. Download the package for your platform from GitHub Releases and follow its installer instructions. On macOS, open Kode Injector Helper and choose Reinstall, Repair, or Uninstall before moving the app to Trash.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${kodeInjector.pageUrl}faq/#faq`,
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<KodeInjectorShell
  title="Kode Injector FAQ & Troubleshooting"
  description={description}
  current="faq"
  structuredData={faqSchema}
>
  <article class="pt-16 sm:pt-24">
    <header class="max-w-4xl">
      <p class="mb-5 text-xs font-medium tracking-[0.18em] text-accent uppercase">
        Answers and troubleshooting
      </p>
      <h1 class="font-display text-5xl leading-[1.06] font-medium text-balance [font-variation-settings:'WONK'_1,'SOFT'_40] sm:text-6xl">
        Kode Injector FAQ
      </h1>
      <p class="mt-7 max-w-3xl text-lg leading-relaxed text-secondary sm:text-xl">
        Start with file access, the current hostname, and the three levels of toggles. Those checks resolve most setup problems.
      </p>
    </header>

    <section class="py-16 sm:py-20" aria-label="Frequently asked questions">
      <div class="divide-y divide-line border-y border-line">
        {
          faqs.map((faq, index) => (
            <details class="group py-6" open={index === 0 ? true : undefined}>
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-medium marker:hidden">
                <span>{faq.question}</span>
                <span aria-hidden="true" class="text-accent group-open:rotate-45">+</span>
              </summary>
              <p class="mt-4 max-w-3xl leading-relaxed text-secondary">
                {faq.answer}
              </p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="grid gap-4 sm:grid-cols-2" aria-label="More help">
      <a
        href={`${kodeInjector.baseUrl}how-it-works/`}
        class="rounded-xl border border-line bg-card p-6 transition-colors hover:border-accent"
      >
        <p class="text-xs font-medium tracking-[0.18em] text-accent uppercase">Setup</p>
        <h2 class="mt-3 text-lg font-medium">Follow the complete guide</h2>
        <p class="mt-2 text-sm leading-relaxed text-secondary">Enable local file access, add a rule, and test a minimal JavaScript or CSS file.</p>
      </a>
      <a
        href={`${kodeInjector.baseUrl}support/`}
        class="rounded-xl border border-line bg-card p-6 transition-colors hover:border-accent"
      >
        <p class="text-xs font-medium tracking-[0.18em] text-accent uppercase">Still stuck?</p>
        <h2 class="mt-3 text-lg font-medium">Contact support</h2>
        <p class="mt-2 text-sm leading-relaxed text-secondary">Collect the browser, extension version, error message, and safe reproduction steps before reporting the issue.</p>
      </a>
    </section>
  </article>
</KodeInjectorShell>
