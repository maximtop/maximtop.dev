---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---

<Layout title={`Page not found — ${site.name}`} description="This page does not exist.">
  <div class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center px-6 py-16">
    <p class="text-xs tracking-[0.2em] text-muted">MAXIMTOP.DEV</p>
    <h1 class="font-display mt-6 text-6xl font-medium [font-variation-settings:'WONK'_1,'SOFT'_40]">
      404
    </h1>
    <p class="font-display mt-4 text-2xl italic">
      This page got <span class="text-accent">blocked</span> a little too well.
    </p>
    <p class="mt-6 text-secondary">
      Occupational hazard when you build ad blockers for a living.
    </p>
    <a href="/" class="mt-8 inline-block text-accent underline underline-offset-4">
      Back to the homepage
    </a>
  </div>
</Layout>
